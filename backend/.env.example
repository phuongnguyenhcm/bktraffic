PORT=3000
FRONTEND_URL=http://localhost:5173
TOMTOM_API_KEY=your_tomtom_api_key
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/traffic_db?retryWrites=true&w=majority

# Thư mục dữ liệu mô phỏng (tương đối với thư mục chạy process — /backend)
DATA_DIR=data

# Chế độ mô phỏng cảm biến từ speed.csv:
#  - latest : luôn dùng chuỗi speed_ratio mới nhất trong file
#  - replay : phát lại dữ liệu theo đồng hồ thực (mỗi 5 phút tiến 1 mốc, lặp vòng)
SIMULATION_MODE=latest
# Múi giờ của cột timestamp trong speed.csv
DATA_TIMEZONE_OFFSET=+07:00

# OSRM routing (tự trích xuất polyline cho edge geometryMode = 'auto')
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_MS=6000
